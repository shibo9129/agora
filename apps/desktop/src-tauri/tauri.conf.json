{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agora",
  "version": "0.1.3",
  "identifier": "dev.agora.hub",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agora — 本地 AI 中枢",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "url": "loading.html"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["sidecar/node-runtime"],
    "resources": ["sidecar/dist", "sidecar/node_modules"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "RWTfGaCxH97+qNfP5iAa1SfiC2mooRVyfCSi0KZyLaqkKCtmvaRJG+dY",
      "endpoints": ["https://github.com/stanshek/agora/releases/latest/download/update.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
