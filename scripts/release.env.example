# Copy to scripts/.release.env and fill in real values.
# scripts/.release.env is gitignored — NEVER commit real credentials.

# 1) Code-signing identity (one-time: Xcode → Settings → Accounts →
#    select your Apple ID → team → Manage Certificates… → "+" → Developer ID Application)
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# 2) Notarization via Apple ID + app-specific password
#    (one-time: https://appleid.apple.com → Sign-In and Security → App-Specific Passwords)
APPLE_ID="you@example.com"
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"   # app-specific password, NOT your Apple ID password
APPLE_TEAM_ID="XXXXXXXXXX"             # 10-char team id, e.g. from `security find-identity`

# 3) Updater (minisign) private key — signs Agora.app.tar.gz for in-app updates.
#    One-time: cargo tauri signer generate -w ~/.agora/tauri-updater.key
#    Then put the matching PUBLIC key into tauri.conf.json → plugins.updater.pubkey.
#    Tauri accepts either the key content or a path to the key file here.
TAURI_SIGNING_PRIVATE_KEY="~/.agora/tauri-updater.key"
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""
